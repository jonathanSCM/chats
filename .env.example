# App
NODE_ENV=development

# Database (Postgres — en Coolify usar la connection string interna del servicio)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/whatsapp_bots?schema=public"

# Auth.js
AUTH_SECRET="" # generar con: npx auth secret
NEXTAUTH_URL="http://localhost:3000"

# Cifrado de credenciales en reposo (tokens de WhatsApp)
APP_ENCRYPTION_KEY="" # generar con: openssl rand -base64 32

# WhatsApp Cloud API (Meta) — a nivel de app; el access token de cada
# número vive cifrado en WhatsAppConnection.accessToken, no aquí.
# WHATSAPP_APP_SECRET es OBLIGATORIA en producción: sin ella, el webhook
# rechaza todo (para que nadie pueda mandar mensajes falsos haciéndose
# pasar por Meta). Se saca del dashboard de tu app en developers.facebook.com.
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN="" # token propio para validar el handshake del webhook

# Coexistence (Embedded Signup) — permite conectar un número que ya se usa
# en la app de WhatsApp Business del celular, sin dejar de usarlo ahí.
# Requiere crear una configuración de "Embedded Signup" con Coexistence
# habilitada en developers.facebook.com para tu app. No son secretas (el
# navegador las necesita para inicializar el SDK de Facebook), pero se sirven
# en runtime vía /api/whatsapp/embedded-signup-config — no llevan prefijo
# NEXT_PUBLIC_, así que se pueden cambiar desde Coolify sin rehacer el build.
WHATSAPP_APP_ID=""
WHATSAPP_CONFIG_ID=""

# Storage S3-compatible para la media de WhatsApp (fotos, video, audio,
# documentos). Sin esto, se guarda en disco local (/public/media) — solo
# seguro si ese path está en un volumen persistente, porque si no se pierde
# todo en el próximo redeploy/reinicio. Funciona con cualquier proveedor
# S3-compatible: MinIO (el que trae Coolify), Cloudflare R2, DigitalOcean
# Spaces, AWS S3, etc.
S3_ENDPOINT="" # ej. https://s3.tu-region.coolify.internal o https://<account>.r2.cloudflarestorage.com
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Correo transaccional (reset de password, verificación, invitaciones).
# Sin RESEND_API_KEY, el mailer solo loguea el contenido en consola.
RESEND_API_KEY=""
MAIL_FROM="WhatsApp ProShop <onboarding@resend.dev>"
