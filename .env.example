# App
NODE_ENV=development

# Database (Postgres — en Coolify usar la connection string interna del servicio)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/whatsapp_bots?schema=public"

# Auth.js
AUTH_SECRET="" # generar con: npx auth secret
NEXTAUTH_URL="http://localhost:3000"

# Cifrado de credenciales en reposo (tokens de WhatsApp)
APP_ENCRYPTION_KEY="" # generar con: openssl rand -base64 32

# OpenAI
OPENAI_API_KEY=""

# WhatsApp Cloud API (Meta) — a nivel de app; el access token de cada
# número vive cifrado en WhatsAppConnection.accessToken, no aquí.
WHATSAPP_APP_ID=""
WHATSAPP_APP_SECRET="" # firma los payloads del webhook (X-Hub-Signature-256)
WHATSAPP_VERIFY_TOKEN="" # token propio para validar el handshake del webhook

# Redis / Colas
REDIS_URL="redis://localhost:6379"

# Stripe
# 1. Crea una cuenta de Stripe (modo test) y copia la Secret key.
# 2. Corre `npm run stripe:sync-plans` para crear los Products/Prices de
#    los planes y el paquete extra (imprime el price id del paquete al final,
#    pégalo en STRIPE_EXTRA_PACK_PRICE_ID).
# 3. En local, expón el webhook con Stripe CLI:
#    `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
#    (el comando imprime el signing secret para STRIPE_WEBHOOK_SECRET).
#    En producción, configura el endpoint desde el dashboard de Stripe.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_EXTRA_PACK_PRICE_ID=""

# Storage (S3-compatible)
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
