# App
NODE_ENV=development

# Database (Postgres — en Coolify usar la connection string interna del servicio)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/whatsapp_bots?schema=public"

# Auth.js
AUTH_SECRET="" # generar con: npx auth secret
NEXTAUTH_URL="http://localhost:3000"

# Cifrado de credenciales en reposo (tokens de WhatsApp)
APP_ENCRYPTION_KEY="" # generar con: openssl rand -base64 32

# WhatsApp Cloud API (Meta) — a nivel de app; el access token de cada
# número vive cifrado en WhatsAppConnection.accessToken, no aquí.
#
# Estas 4 son solo el respaldo inicial: una vez que la app arranca, se
# pueden (y conviene) cargar/cambiar desde Admin → Configuración
# (/admin/settings) sin tocar variables de entorno ni redesplegar — lo
# guardado ahí siempre gana sobre esto.
#
# WHATSAPP_APP_SECRET es OBLIGATORIA en producción (aquí o en /admin/settings):
# sin ella, el webhook rechaza todo (para que nadie pueda mandar mensajes
# falsos haciéndose pasar por Meta). Se saca del dashboard de tu app en
# developers.facebook.com.
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN="" # token propio para validar el handshake del webhook
WHATSAPP_APP_ID="" # Coexistence (Embedded Signup) — App ID de tu app de Meta
WHATSAPP_CONFIG_ID="" # Coexistence — config_id de la configuración con Coexistence habilitada

# Storage S3-compatible para la media de WhatsApp (fotos, video, audio,
# documentos). Sin esto, se guarda en disco local (/public/media) — solo
# seguro si ese path está en un volumen persistente, porque si no se pierde
# todo en el próximo redeploy/reinicio. Funciona con cualquier proveedor
# S3-compatible: MinIO (el que trae Coolify), Cloudflare R2, DigitalOcean
# Spaces, AWS S3, etc.
S3_ENDPOINT="" # ej. https://s3.tu-region.coolify.internal o https://<account>.r2.cloudflarestorage.com
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Asesor IA (OpenAI). Sin OPENAI_API_KEY la app funciona igual: las columnas
# de IA quedan vacías y el botón "Analizar" aparece deshabilitado.
OPENAI_API_KEY=""
# Los nombres de modelo cambian seguido, por eso son configurables y no van
# escritos en el código.
OPENAI_MODEL_FAST="gpt-4.1-mini"
OPENAI_MODEL_ANALYSIS="gpt-4.1-mini"
OPENAI_MODEL_EXECUTIVE="gpt-4.1"
# Precio por millón de tokens, solo para estimar el gasto y cortar a tiempo.
OPENAI_PRICE_INPUT_PER_M="0.4"
OPENAI_PRICE_OUTPUT_PER_M="1.6"
# Precio de los tokens de entrada que pegan contra el cache automático de
# OpenAI (más barato que el de entrada normal). Sin esta variable se asume la
# mitad del precio de entrada — ajustar si el precio real publicado difiere.
OPENAI_PRICE_CACHED_INPUT_PER_M="0.2"
# Tope de gasto diario en USD: al superarlo se deja de analizar hasta el día
# siguiente. El manual sugiere entre 5 y 20 USD al mes para dos vendedores.
AI_DAILY_BUDGET_USD="2"
# Interruptor para desplegar sin activar la IA todavía.
AI_ENABLED="true"

# Cola de trabajos — el endpoint /api/cron/tick procesa reintentos y trabajos
# diferidos. Se invoca desde una Scheduled Task de Coolify cada minuto con
# este token en la cabecera Authorization. Generar con: openssl rand -base64 32
CRON_SECRET=""

# Web Push — notificaciones del sistema en móvil y escritorio, incluso con
# la app cerrada. Genera el par de llaves una sola vez con:
#   npx web-push generate-vapid-keys
# Sin estas variables la app igual funciona, pero los avisos solo aparecen
# mientras la pestaña está abierta.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:tu-correo@dominio.com"

# Correo transaccional (reset de password, verificación, invitaciones).
# Sin RESEND_API_KEY, el mailer solo loguea el contenido en consola.
RESEND_API_KEY=""
MAIL_FROM="WhatsApp ProShop <onboarding@resend.dev>"

# Google Calendar — genera el link de Meet al agendar una reunión desde el
# sistema. Una sola cuenta de Google común (no hace falta Workspace),
# compartida por toda la organización: al ser la que crea el evento, queda
# como organizadora y por eso el futuro bot de grabación (que se une con la
# misma cuenta) nunca necesita que nadie lo "admita" a la reunión.
# Client ID/Secret: proyecto en console.cloud.google.com con la Calendar API
# habilitada. El refresh token se obtiene una única vez corriendo el flujo de
# OAuth contra esa cuenta (no expira solo). Sin estas 3 variables, el
# checkbox "Crear con Google Meet" del formulario de reuniones muestra un
# error pidiendo que se configure.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_BOT_REFRESH_TOKEN=""

# Monitoreo de errores (Sentry). Sin DSN, el SDK queda desactivado sin
# romper nada — útil para no configurarlo en local. Crea un proyecto
# gratis en sentry.io (tipo "Next.js") y copia el DSN de ahí.
SENTRY_DSN="" # servidor
NEXT_PUBLIC_SENTRY_DSN="" # navegador — normalmente el mismo valor que SENTRY_DSN
# Opcionales, solo para que el build suba source maps legibles a Sentry:
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
