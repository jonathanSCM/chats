# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/meeting-bot/node_modules

# perfil de Chrome logueado con la cuenta del bot (cookies de sesión reales,
# nunca se commitea — se sube a mano al volumen del servidor, ver README)
/meeting-bot/chrome-profile-local

# capturas de pantalla bajadas del contenedor para diagnosticar en el momento
/meeting-bot/meeting-bot-debug
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# claude code local settings
.claude/settings.local.json

# archivos ajenos al proyecto / dumps locales
/TEST
dump.rdb

# media subida en runtime (imágenes/audio/video/docs de WhatsApp)
/public/media

# respaldos locales de la base de datos
/backups
