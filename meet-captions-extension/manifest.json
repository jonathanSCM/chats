{
  "manifest_version": 3,
  "name": "ProShop CRM — Asistente de reuniones de Meet",
  "short_name": "ProShop Meet",
  "version": "2.1.0",
  "minimum_chrome_version": "116",
  "description": "Graba los subtítulos y el audio de tus reuniones de Google Meet y los guarda en tu CRM, con subtítulos en vivo en un panel.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab", "tabCapture", "offscreen", "sidePanel"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://chats.proshop.lat/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["captions-dom.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chats.proshop.lat/dashboard/extension-authorize*"],
      "js": ["authorize-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ProShop CRM — Asistente de reuniones",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
