# Puerto interno del servicio (Coolify lo expone solo en la red interna, no
# hace falta un dominio público).
PORT=4000

# Mismo valor que BOT_SERVICE_SECRET en la app principal — autoriza el
# POST /join. Generar con: openssl rand -base64 32
BOT_SERVICE_SECRET=""

# Mismo valor que MEETING_BOT_WEBHOOK_SECRET en la app principal — se manda
# como Bearer al subir la grabación de vuelta.
MEETING_BOT_WEBHOOK_SECRET=""
