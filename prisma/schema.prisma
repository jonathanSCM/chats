// Prisma schema — WhatsApp Bots Platform
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth / Tenancy ─────────────────────────────────────────────

enum UserRole {
  SUPERADMIN // dueño de la plataforma, ve todo
  OWNER // dueño de la organización/cliente
  MEMBER // usuario dentro de la organización del cliente
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  suspended Boolean  @default(false) // desactivada por el superadmin (ej. impago, abuso)
  // Cuántos mensajes recientes de WhatsApp se le mandan al asesor IA por
  // análisis (ajustable por el dueño en /dashboard/organization). Más
  // mensajes = más contexto pero más costo por análisis.
  aiMessageLimit Int      @default(25)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  bots           Bot[]
  invites        OrganizationInvite[]
  knowledgeItems KnowledgeItem[]
  companies      Company[]
  contacts       Contact[]
  opportunities  Opportunity[]
  activities     Activity[]
  meetings       Meeting[]
  aiAnalyses     AiAnalysis[]

  @@map("organizations")
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  passwordHash   String?
  name           String?
  // MEMBER, no OWNER: el default debe ser el rol menos privilegiado. Los dos
  // flujos que crean usuarios (signup.ts, team.ts) siempre pasan `role`
  // explícito, así que esto solo protege un camino futuro que lo olvide.
  role           UserRole      @default(MEMBER)
  emailVerified  DateTime?
  // Color fijo para identificar al vendedor de un vistazo (asignaciones,
  // avatares, notas). Si es null, se deriva un color determinístico del id
  // (ver src/lib/vendor-color.ts) — así nadie tiene que elegir uno antes de
  // que exista esta opción.
  color          String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  assignedConversations   Conversation[]           @relation("ConversationAssignee")
  sentMessages            Message[]                @relation("MessageSender")
  conversationReads       ConversationRead[]
  pushSubscriptions       PushSubscription[]
  knowledgeEdits          KnowledgeItem[]          @relation("KnowledgeEditor")
  conversationNotes       ConversationNote[]       @relation("NoteAuthor")
  ownedContacts           Contact[]                @relation("ContactOwner")
  ownedOpportunities      Opportunity[]            @relation("OpportunityOwner")
  ownedActivities         Activity[]               @relation("ActivityOwner")
  botAccess               BotMember[]

  @@index([organizationId])
  @@map("users")
}

// ─── Tokens de un solo uso (reset de password, verificación de email) ──

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

// Invitación para unirse a una organización existente como MEMBER (u OWNER).
model OrganizationInvite {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String? // opcional: restringe la invitación a un correo específico
  role           UserRole     @default(MEMBER)
  tokenHash      String       @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@map("organization_invites")
}

// ─── Bots ───────────────────────────────────────────────────────

model Bot {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  status         BotStatus    @default(DRAFT)
  // Independiente de `status` (que solo indica si el número está
  // conectado): habilita que el bot de IA conteste solo los primeros
  // mensajes de un lead siguiendo la guía de calificación de la Base de
  // Conocimiento. Apagado por defecto — opt-in explícito por cuenta.
  aiQualificationEnabled Boolean  @default(false)
  // Modo de prueba: si tiene valor, el bot SOLO contesta conversaciones con
  // este teléfono exacto (aunque aiQualificationEnabled esté activo) — para
  // probar en producción sin arriesgar leads reales. Vacío/null = responde
  // a todos.
  aiTestPhone            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  whatsappConnection WhatsAppConnection?
  conversations      Conversation[]
  members            BotMember[]

  @@index([organizationId])
  @@map("bots")
}

enum BotStatus {
  DRAFT
  ACTIVE
  PAUSED
}

// Qué vendedores (MEMBER) pueden ver/atender cada cuenta de WhatsApp. Sin
// fila acá, un MEMBER no ve los chats de ese bot — es la restricción real
// de acceso por cuenta. OWNER y SUPERADMIN no necesitan estar acá: siempre
// ven todas las cuentas de su organización, igual que en el resto del panel.
model BotMember {
  id        String   @id @default(cuid())
  botId     String
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([botId, userId])
  @@index([userId])
  @@map("bot_members")
}

model WhatsAppConnection {
  id                String            @id @default(cuid())
  botId             String            @unique
  bot               Bot               @relation(fields: [botId], references: [id], onDelete: Cascade)
  phoneNumberId     String            @unique // Meta phone_number_id
  wabaId            String? // WhatsApp Business Account ID
  displayNumber     String? // número visible (ej. +591 700 12345), para el link "click to chat"
  accessToken       String            @db.Text // cifrado a nivel de aplicación
  verified          Boolean           @default(false)
  coexistence       Boolean           @default(false) // conectado vía Embedded Signup en modo Coexistence (mismo número también usado en la app de WhatsApp Business)
  historySyncStatus HistorySyncStatus @default(NONE)
  createdAt         DateTime          @default(now())

  @@map("whatsapp_connections")
}

enum HistorySyncStatus {
  NONE // no aplica (conexión sin coexistence) o todavía no llegó nada
  PENDING // coexistence conectado, esperando el webhook "history" de Meta
  COMPLETE // historial ya importado
}

// ─── Base de conocimiento ───────────────────────────────────────
//
// Material autorizado de la empresa que la IA puede citar al analizar y
// recomendar: servicios, precios, alcances, exclusiones, FAQ, políticas.
// Se edita desde el panel. Cada entrada lleva responsable y versión para
// saber quién la actualizó y cuándo (manual §26).
model KnowledgeItem {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       KnowledgeCategory
  title          String
  content        String            @db.Text
  active         Boolean           @default(true)
  version        Int               @default(1)
  updatedById    String?
  updatedBy      User?             @relation("KnowledgeEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organizationId, category])
  @@map("knowledge_items")
}

enum KnowledgeCategory {
  SERVICE // servicio que ofrece la empresa
  PRICING // precios aprobados o reglas de cotización
  SCOPE // alcances típicos y tiempos estimados
  EXCLUSION // lo que NO se incluye
  FAQ // preguntas frecuentes
  POLICY // políticas comerciales
  CASE_STUDY // ejemplos de proyectos
  QUALIFICATION // guías para calificar leads
  TONE // tono y estilo de comunicación
}

// ─── Conversaciones ─────────────────────────────────────────────

model Conversation {
  id            String   @id @default(cuid())
  botId         String
  bot           Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  customerPhone String
  customerName  String? // viene del webhook smb_app_state_sync (contactos del negocio) o del profile.name del contacto
  startedAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())
  billed        Boolean  @default(false) // ya contabilizada contra el plan/uso
  botPaused     Boolean  @default(false) // un humano tomó la conversación; el bot no responde solo
  // Resumen acumulado de lo que el bot de calificación fue aprendiendo en
  // esta conversación (rubro, qué quiere mejorar, problema, rol del
  // contacto...). Mismo patrón que Opportunity.aiMemory, pero vive acá
  // porque antes de calificar todavía no existe ninguna Opportunity donde
  // guardarlo.
  botMemory     String?  @db.Text
  // Bloquear impide seguir mandándole mensajes desde el panel (cliente
  // abusivo, spam, etc.) sin borrar el historial. Distinto de "archivar"
  // (status CLOSED), que solo la saca de la bandeja del día a día.
  blocked       Boolean  @default(false)

  // Ventana extendida de Meta para leads que llegan por un anuncio "Click to
  // WhatsApp": si el primer mensaje trae un objeto "referral" y alguien del
  // equipo responde dentro de las 24h normales, se activan 72h de gracia sin
  // necesitar plantilla. Ver services/whatsapp.ts y services/conversation.ts.
  adReferral          Boolean   @default(false)
  adReferralAt        DateTime?
  freeEntryPointUntil DateTime?

  // Vendedor dueño de esta conversación — se asigna automáticamente al
  // primer vendedor que responde. Mientras sea null, cualquier vendedor la
  // ve en su bandeja como "sin asignar"; una vez asignada, solo ese
  // vendedor (y los admins/OWNER) la ven.
  assignedToId String?
  assignedTo   User?   @relation("ConversationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  // Se enlaza al contacto del CRM por teléfono. Es nullable porque el
  // mensaje entra por el webhook antes de que exista ficha de CRM.
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  status ConversationStatus @default(OPEN)
  // Etiquetas libres para clasificar (el equipo ya usa "AGENTES IA",
  // "SISTEMAS", "APP", "TAXI" en su planilla).
  tags   String[]           @default([])

  notes ConversationNote[]

  messages Message[]
  reads    ConversationRead[]

  @@index([botId])
  @@index([customerPhone])
  @@index([assignedToId])
  @@map("conversations")
}

// Suscripción de Web Push por dispositivo/navegador — un mismo vendedor
// puede tener varias (celular, laptop, etc.). Se borra sola cuando el
// navegador la invalida (respuesta 404/410 al mandar la notificación).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique @db.Text
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

// Marca de "leído" por vendedor/admin — cada usuario tiene su propio
// puntero de lectura sobre una conversación (no es un estado global).
model ConversationRead {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime     @default(now())

  @@unique([conversationId, userId])
  @@map("conversation_reads")
}

enum ConversationStatus {
  OPEN    // el cliente espera respuesta o el tema sigue vivo
  ON_HOLD // pausada a propósito, se retoma después
  CLOSED  // atendida; no aparece en la bandeja del día a día
}

// Nota interna del equipo: no se envía a WhatsApp. Equivale a la columna
// "Última actualización" que el equipo mantiene a mano en su planilla, que
// es donde de verdad vive el contexto de cada cliente.
model ConversationNote {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation("NoteAuthor", fields: [userId], references: [id], onDelete: SetNull)
  body           String       @db.Text
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("conversation_notes")
}

enum MessageRole {
  CUSTOMER
  BOT
  STAFF // enviado manualmente por alguien del equipo, con el bot pausado
  SYSTEM
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String        @db.Text
  mediaUrl       String?
  mediaType      MediaType?
  // Solo aplica cuando mediaType no es null: la descarga desde el CDN de
  // Meta ocurre en un job aparte, así que el mensaje aparece en la bandeja
  // antes de que el archivo esté disponible.
  mediaStatus    MediaStatus?
  mimeType       String?
  fileName       String?
  externalId     String?       @unique // id del mensaje en WhatsApp, para idempotencia del webhook
  viaPhoneApp    Boolean       @default(false) // llegó como eco de un mensaje mandado desde la app de WhatsApp Business (coexistence), no desde este panel
  isHistorical   Boolean       @default(false) // importado del historial (webhook "history"), no un mensaje en vivo
  sentById       String? // vendedor que mandó este mensaje desde el panel (solo para role STAFF enviado aquí, no vía phone app)
  sentBy         User?         @relation("MessageSender", fields: [sentById], references: [id], onDelete: SetNull)
  status         MessageStatus @default(SENT) // solo relevante para mensajes salientes (STAFF): confirmación de entrega/lectura de Meta
  errorDetail    String? // motivo legible cuando status es FAILED (ver services/whatsapp.ts describeMessageError)
  createdAt      DateTime      @default(now())

  @@index([conversationId])
  @@map("messages")
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum MediaStatus {
  PENDING // encolada para descargar del CDN de Meta
  READY // guardada y servible
  FAILED // se agotaron los reintentos
}

// ─── Cola de trabajos ───────────────────────────────────────────
//
// Cola en Postgres en vez de Redis/BullMQ: el volumen de este producto
// (decenas de conversaciones al día) no justifica otro servicio que operar.
// El reclamo de trabajos usa FOR UPDATE SKIP LOCKED, así que varios ticks
// concurrentes nunca toman el mismo job.
model Job {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  // Clave de idempotencia: evita encolar dos veces lo mismo cuando Meta
  // reenvía un webhook o el cron se solapa (manual §37).
  uniqueKey   String?   @unique
  status      JobStatus @default(PENDING)
  runAfter    DateTime  @default(now()) // permite trabajos diferidos (debounce, recordatorios)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  lastError   String?   @db.Text
  lockedAt    DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAfter])
  @@map("jobs")
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

// ─── Auditoría ──────────────────────────────────────────────────
//
// Quién cambió qué y desde dónde. El manual (§38) lo exige sobre todo para
// distinguir lo que tocó la IA de lo que aprobó una persona.
model AuditLog {
  id             String     @id @default(cuid())
  organizationId String?
  userId         String? // null cuando el actor es el sistema o la IA
  actor          AuditActor @default(USER)
  entityType     String
  entityId       String
  action         String
  before         Json?
  after          Json?
  createdAt      DateTime   @default(now())

  @@index([entityType, entityId])
  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

enum AuditActor {
  USER
  SYSTEM
  AI
}

// ─── CRM ────────────────────────────────────────────────────────
//
// Nota de diseño: el manual separa `leads` de `opportunities`, pero su
// propio MVP (§40) pide "contactos y oportunidades". Mantener las dos
// entidades obliga al vendedor a actualizar lo mismo en dos lugares y en
// equipos chicos terminan desincronizadas, así que los campos de
// calificación (necesidad, presupuesto, urgencia, autoridad, score) viven
// directamente en Opportunity.

model Company {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  industry       String?
  size           String?
  website        String?
  city           String?
  country        String?
  notes          String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  contacts Contact[]

  @@index([organizationId])
  @@map("companies")
}

model Contact {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fullName       String?
  phone          String
  email          String?
  jobTitle       String?
  city           String?
  country        String?
  source         String? // de dónde salió (WhatsApp, referido, campaña…)
  companyId      String?
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  assignedToId   String?
  assignedTo     User?        @relation("ContactOwner", fields: [assignedToId], references: [id], onDelete: SetNull)
  firstContactAt DateTime     @default(now())
  lastContactAt  DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  conversations Conversation[]
  opportunities Opportunity[]
  activities    Activity[]

  // El teléfono identifica al contacto dentro de la organización: es la
  // llave con la que llega WhatsApp y evita duplicados (manual §14).
  @@unique([organizationId, phone])
  @@index([organizationId])
  @@map("contacts")
}

// Etapas del embudo (manual §7). Cada una debería tener criterios claros de
// entrada y salida documentados en la base de conocimiento.
// Estados tal como los usa el equipo en su planilla de seguimiento, no los
// del manual: si el sistema no habla su idioma, no lo usan.
enum OpportunityStage {
  POR_CALIFICAR
  ENTREVISTA
  DIAGNOSTICO
  PRESENTAR_SOLUCION
  PROPUESTA
  DECISION
  GANADO
  EN_PAUSA_NUTRIR
  PERDIDO
}

enum Priority {
  ALTA
  MEDIA
  BAJA
}

enum DataStatus {
  CONFIRMED // lo dijo el cliente
  INFERRED // lo dedujo la IA y falta que el vendedor lo confirme
  UNKNOWN
}

// Categoría fija para poder rankear motivos de pérdida en el Dashboard —
// `lostReason` (texto libre) sigue existiendo como el detalle de esta
// categoría, no se reemplaza.
enum LossReason {
  PRESUPUESTO
  SIN_URGENCIA
  ELIGIO_COMPETENCIA
  NO_RESPONDIO
  PROYECTO_CANCELADO
  NO_FIT
  DECISION_POSTERGADA
  OTRO
}

model Opportunity {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedToId   String?
  assignedTo     User?        @relation("OpportunityOwner", fields: [assignedToId], references: [id], onDelete: SetNull)

  title             String
  stage             OpportunityStage @default(POR_CALIFICAR)
  serviceInterest   String?
  estimatedValue    Decimal?         @db.Decimal(12, 2)
  currency          String           @default("USD")
  probability       Int? // 0-100

  // Archivar saca al cliente de la vista principal sin borrar nada (a
  // diferencia de "Quitar del seguimiento", que sí elimina). sortOrder es
  // el orden manual que el equipo arma arrastrando filas; se usa como orden
  // por defecto cuando no hay ninguna columna ordenada.
  archivedAt DateTime?
  sortOrder  Int       @default(0)
  expectedCloseDate DateTime?

  // Calificación (manual §9): score 0-100 con el desglose que lo justifica.
  // Es un indicador DISTINTO de `probability` (probabilidad de cierre) — un
  // lead puede tener leadScore 90 y probability 40 a la vez (buen encaje
  // comercial, pero todavía sin reunión/presupuesto/decisión).
  leadScore          Int?
  leadScoreBreakdown Json? // { empresaEnMarcha, dolorConcreto, impacto, decisor, capacidadInversion, encajeProshop, urgencia }
  leadScoreCoverage  Int? // % de la información necesaria que ya se conoce
  leadScoreUpdatedAt DateTime?
  aiPainPoint        String?   @db.Text // dolor principal, una frase
  aiMissingInfo      String?   @db.Text // qué falta saber, hasta 3 puntos
  aiNextQuestion     String?   @db.Text // la siguiente pregunta que debería hacer el vendedor
  aiAlerts           String?   @db.Text // contradicciones o datos poco confiables a revisar
  priority       Priority?
  needSummary    String?    @db.Text
  // Texto libre que el equipo mantiene por cliente ("no contesta hace una
  // semana", "pidió más tiempo"): la columna que más usan de su planilla.
  lastUpdate     String?    @db.Text
  nextContactAt  DateTime?
  needStatus     DataStatus @default(UNKNOWN)
  budgetRange    String?
  budgetStatus   DataStatus @default(UNKNOWN)
  urgency        String?
  authorityLevel String?

  // Regla dura del manual (§45): toda oportunidad activa debe tener
  // próximo paso. Se valida en la aplicación, no en la base, para poder
  // avisar en vez de reventar.
  nextAction   String?
  nextActionAt DateTime?

  // Salidas del asesor IA. Se guardan aparte de lo que escribe la persona
  // para poder distinguir siempre quién dijo qué (manual §28).
  aiRecommendation    String?   @db.Text
  aiSuggestedMessage  String?   @db.Text
  aiReviewedAt        DateTime?
  // Resumen vivo que la propia IA mantiene y reescribe en cada análisis: lo
  // importante que aprendió del cliente a lo largo de toda la conversación,
  // no solo de la ventana de mensajes recientes que se le manda cada vez.
  aiMemory            String?   @db.Text
  aiMemoryUpdatedAt   DateTime?

  proposalSentAt DateTime?
  wonAt          DateTime?
  lostAt         DateTime?
  lostReason     String?
  lostReasonCategory LossReason?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  activities Activity[]
  meetings   Meeting[]

  @@index([organizationId, stage])
  @@index([contactId])
  @@map("opportunities")
}

enum ActivityType {
  TASK
  CALL
  MESSAGE
  PROPOSAL
  FOLLOW_UP
}

enum ActivityStatus {
  PENDING
  DONE
  CANCELED
}

model Activity {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  opportunityId  String?
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  assignedToId   String?
  assignedTo     User?        @relation("ActivityOwner", fields: [assignedToId], references: [id], onDelete: SetNull)

  type        ActivityType   @default(TASK)
  title       String
  description String?        @db.Text
  dueAt       DateTime?
  completedAt DateTime?
  status      ActivityStatus @default(PENDING)
  // "user" si la creó una persona, "ai" si salió de un análisis: sirve para
  // medir cuánto aporta realmente el asesor (manual §38).
  source      String         @default("user")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([organizationId, status, dueAt])
  @@index([opportunityId])
  @@map("activities")
}

enum MeetingStatus {
  SCHEDULED
  CONFIRMED
  DONE
  CANCELED
  NO_SHOW
}

model Meeting {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunityId   String?
  opportunity     Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  scheduledAt     DateTime
  durationMinutes Int           @default(30)
  meetingUrl      String?
  location        String?
  status          MeetingStatus @default(SCHEDULED)
  notes           String?       @db.Text
  aiSummary       String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  attachments MeetingAttachment[]

  @@index([organizationId, scheduledAt])
  @@map("meetings")
}

// Varios archivos por reunión (audio, transcripción en PDF, capturas, etc.)
// — reusa el mismo almacenamiento (S3 o disco local) que los adjuntos del
// inbox, ver lib/media-storage.ts.
model MeetingAttachment {
  id        String   @id @default(cuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  url       String
  fileName  String
  mimeType  String
  fileSize  Int
  createdAt DateTime @default(now())

  @@index([meetingId])
  @@map("meeting_attachments")
}

// ─── Asesor IA ──────────────────────────────────────────────────
//
// Registro de cada llamada al modelo: qué se pidió, qué devolvió, cuántos
// tokens costó y con qué versión de prompt. Sin esto no se puede medir el
// costo por conversación ni reproducir un análisis viejo (manual §21, §34).
model AiAnalysis {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType     String // "Opportunity", "Conversation"…
  entityId       String
  analysisType   String // "seguimiento", "coaching"…
  model          String
  promptVersion  String
  inputTokens    Int
  outputTokens   Int
  costEstimate   Decimal?     @db.Decimal(10, 6)
  result         Json?
  error          String?      @db.Text
  durationMs     Int?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("ai_analyses")
}

// ─── Configuración de plataforma ─────────────────────────────────
//
// Credenciales de la app de Meta que usa TODA la plataforma para
// Coexistence/Embedded Signup (no son por organización — es una sola app
// de Meta detrás de todos los negocios). Fila única (id fijo "singleton")
// para poder editarla desde /admin/settings sin tocar variables de entorno
// ni redesplegar. Si está vacía, el código cae a las variables de entorno
// (WHATSAPP_APP_ID, etc.) — así no rompe despliegues que ya las tenían ahí.
model PlatformSetting {
  id                  String   @id @default("singleton")
  whatsappAppId       String?
  whatsappAppSecret   String?  @db.Text // cifrado, igual que WhatsAppConnection.accessToken
  whatsappConfigId    String?
  whatsappVerifyToken String?
  updatedAt           DateTime @updatedAt

  @@map("platform_settings")
}
